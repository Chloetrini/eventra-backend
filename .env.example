# Copy to .env and fill in. Never commit the real .env.

# --- Core (required) ---
NODE_ENV=development
LOG_LEVEL=info
PORT=4000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
DATABASE_NAME=eventra
SESSION_SECRET=change-me
SESSION_MAX_AGE=604800000
CLIENT_URL=http://localhost:4001
API_URL=http://localhost:4000

# --- Cloudinary (required, image uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Paystack (required, payments and payouts) ---
PAYSTACK_SECRET_KEY=

# --- Email via Brevo (needed for any email to be delivered) ---
BREVO_API_KEY=
# Must be a sender address verified in your Brevo account
EMAIL_OWNER=
# Comma-separated list of admins who receive enquiry notifications
ADMIN_NOTIFICATION_EMAILS=

# --- Cron endpoints (shared secret checked on /api/cron-*) ---
CRON_SECRET=

# --- Optional ---
GOOGLE_CLIENT_ID=
MEMCACHIER_SERVERS=
MEMCACHIER_USERNAME=
MEMCACHIER_PASSWORD=

# --- Seed scripts (npm run seed:admin) ---
SEED_ADMIN_FULLNAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PHONE=
SEED_ADMIN_PASSWORD=
